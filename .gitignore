# Compiled output — dist IS committed (pre-built for low-RAM deployment)
# dist/
build/

# Node modules
node_modules/

# Environment variables - NEVER commit
.env
.env.local
.env.*.local

# Prisma generated client (rebuilt by `prisma generate`)
node_modules/.prisma/
node_modules/@prisma/client/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# WhatsApp session data — runtime-generated, never commit
wa-session/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Test
coverage/
